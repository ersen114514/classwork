text = input("please enter your text：")
letter = input("Enter the letter you want to search for:  ")
times = 0
place = []
for QAQ in range(len(text)):
    if text[QAQ] == letter:
        times += 1
        place.append(QAQ) 
print(f"Your letter appeared {times} times.")
print(f"In the {place} positions respectively")
